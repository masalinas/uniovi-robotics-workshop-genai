{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-m", "not matlab"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  "files.associations": {
    "*.m": "matlab"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  }

  // Nota: el permiso del agente para lanzar MATLAB/`matlab -batch` se configura en
  // Antigravity > Project Settings > Agent Settings > Permissions (command/unsandboxed),
  // no aquí. Al ser un binario externo pesado, conviene dejarlo en modo "Ask" y no en
  // "Allow" automático.
}
