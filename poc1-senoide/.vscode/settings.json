{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  }

  // Nota: el permiso del agente para ejecutar comandos de terminal (pytest, ruff, etc.)
  // NO se configura aquí, sino en Antigravity > Project Settings > Agent Settings >
  // Terminal Execution Policy (o en el fichero de permisos del proyecto). Este
  // settings.json solo afecta al editor, no al comportamiento del agente.
}
